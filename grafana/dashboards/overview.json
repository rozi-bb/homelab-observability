    {
      "id": 22,
      "title": "\ud83d\udee0\ufe0f Maintenance Log",
      "type": "text",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "options": {
        "mode": "markdown",
        "content": "| Date | Activity |\n|---|---|\n| **August 13, 2026** | Thermal paste replaced with **Arctic MX-6** |\n| **August 13, 2026** | Dust cleaned out (fans & heatsink) |\n| **April 2026** | Serviced at an ASUS Service Center |\n\nRelevant context for interpreting the CPU/GPU temperature trends in the panels below \u2014 the baseline shifted after this maintenance, so data before & after these dates isn't apples-to-apples."
      }
    },
    {
      "id": 19,
      "title": "CPU Package Temp - Current",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "node_hwmon_temp_celsius{chip=~\".*coretemp.*\", sensor=\"temp1\"}",
          "legendFormat": "current",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "description": "Package id 0 temperature right now (real-time, not historical)."
    },
