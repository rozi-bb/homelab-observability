# Secrets & environment
.env

# Prometheus/Loki/Grafana persistent data (bind mounts / volumes if used locally)
prometheus-data/
loki-data/
grafana-data/
alertmanager-data/

# lm-sensors/docker-status textfile collector output (host-local, generated
# at runtime by node-exporter-textfile/docker-status.sh) — the script itself
# IS committed, only its generated output is ignored. *.prom.tmp.<pid> is the
# script's atomic-write intermediate file (write-temp-then-rename) — it only
# exists for a moment, but can get caught by `git add` on unlucky timing.
node-exporter-textfile/*.prom
node-exporter-textfile/*.prom.tmp.*

# OS/editor cruft
.DS_Store
*.swp
