global:
  resolve_timeout: 5m

route:
  receiver: telegram-default
  group_by: ["alertname"]
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Disk critical can be noisy while you're working; for homelab, once/day is enough.
    - matchers:
        - alertname="DiskSpaceCritical"
      receiver: telegram-default
      repeat_interval: 24h

    # Anything else marked critical gets a faster repeat.
    - matchers:
        - severity="critical"
      receiver: telegram-default
      repeat_interval: 1h

    # Disk warning can be "ongoing" for days; make it much less chatty.
    - matchers:
        - alertname="DiskSpaceWarning"
      receiver: telegram-default
      repeat_interval: 24h

receivers:
  - name: telegram-default
    telegram_configs:
      - bot_token: "__TELEGRAM_BOT_TOKEN__"
        chat_id: __TELEGRAM_CHAT_ID__
        parse_mode: "HTML"
        message: |
          {{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }} <b>{{ .CommonLabels.alertname }}</b> ({{ .Status }})
          {{ range .Alerts }}
          {{ .Annotations.summary }}
          {{ .Annotations.description }}
          {{ end }}

inhibit_rules:
  # If the whole textfile exporter has gone stale, ContainerCrashLooping and
  # ContainerRestartedRecently are reading garbage data anyway — no point
  # paging for both the symptom and its own root cause at once.
  - source_matchers:
      - alertname="DockerStatusExporterStale"
    target_matchers:
      - alertname=~"ContainerCrashLooping|ContainerRestartedRecently"

  # When critical disk is firing, the warning is redundant.
  - source_matchers:
      - alertname="DiskSpaceCritical"
    target_matchers:
      - alertname="DiskSpaceWarning"
    equal: ["instance", "mountpoint"]
