# Copy this file to .env and fill in real values. .env is gitignored.

# --- Tailscale ---
# This machine's tailnet IP. Every service port binds to this address only, so
# the stack is unreachable from anything not on the tailnet.
#
# NOTE: prometheus/prometheus.yml also references this address literally, for
# the node_exporter target. node_exporter runs with network_mode: host (needed
# for real network-interface metrics), so Prometheus cannot reach it by Docker
# DNS name. If you fork this repo, change it in both places.
TAILSCALE_IP=100.77.191.60

# --- Grafana ---
# Generate a real password, do not ship the placeholder:
#   openssl rand -base64 24
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_START

# --- Alerting (Phase 3 — required) ---
# Alertmanager routes alert rules to Telegram via its native telegram_configs
# receiver. Both variables are required: the config is rendered from them at
# container startup, so the stack won't start without them.
#
# Create a bot via @BotFather for the token, then message it once (/start) and
# read your chat ID back from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
